rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /gifts/{giftId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['bought', 'boughtBy'])
                   && request.resource.data.bought is bool
                   && (!('boughtBy' in request.resource.data) || request.resource.data.boughtBy is string);
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['from', 'text', 'ts'])
                   && request.resource.data.from is string && request.resource.data.from.size() <= 60
                   && request.resource.data.text is string && request.resource.data.text.size() <= 600
                   && request.resource.data.ts == request.time;
      allow update, delete: if false;
    }

    match /palpites/{palpiteId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['nome', 'data', 'hora', 'peso', 'tamanho', 'ts'])
                   && request.resource.data.nome is string && request.resource.data.nome.size() <= 60
                   && request.resource.data.data is string && request.resource.data.data.size() <= 10
                   && request.resource.data.hora is string && request.resource.data.hora.size() <= 5
                   && request.resource.data.peso is number && request.resource.data.peso > 0 && request.resource.data.peso <= 7
                   && request.resource.data.tamanho is number && request.resource.data.tamanho > 0 && request.resource.data.tamanho <= 60
                   && request.resource.data.ts == request.time;
      allow update, delete: if false;
    }
  }
}
